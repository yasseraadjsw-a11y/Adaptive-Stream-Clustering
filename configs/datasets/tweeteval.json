{
  "dataset": "tweeteval",
  "n_clusters": 3,
  "window_size": 2000,
  "projection_dim": 256,
  "initial_rank": 8,
  "min_rank": 4,
  "max_rank": 32,
  "microcluster_radius": 0.85,
  "decay": 0.95,
  "threshold_smoothing": 0.9,
  "leverage_regularization": 0.001,
  "retained_energy": 0.95,
  "projection_sparsity": 3,
  "max_microclusters": 200,
  "vectorization": {
    "method": "HashingVectorizer",
    "n_features": 2048,
    "ngram_range": [
      1,
      2
    ],
    "alternate_sign": false,
    "norm": "l2"
  },
  "seeds": [
    7,
    13,
    19,
    23,
    31,
    37,
    41,
    43,
    47,
    53
  ],
  "baseline_settings": {
    "clustream": {
      "max_microclusters": 200,
      "radius": 0.85,
      "decay": 1.0
    },
    "denstream": {
      "epsilon": 0.85,
      "beta": 0.2,
      "mu": 6.0,
      "lambda": 0.01,
      "max_microclusters": 200
    },
    "streamkmpp": {
      "coreset_size": 500,
      "buffer_size": 1000
    }
  }
}
